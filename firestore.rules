rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'daiviktiwari28@gmail.com';
    }

    function isCampusEmail() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && (
          request.auth.token.email.lower().matches('^[^@\\s]+@([a-z0-9-]+\\.)*jdcoem\\.(ac\\.)?in$')
          || request.auth.token.email.lower() == 'daiviktiwari28@gmail.com'
        );
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isCampusEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidAdminUser(data, adminId) {
      return data.keys().hasAll(['uid'])
        && data.keys().hasOnly(['uid'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == adminId;
    }

    function matchesUserProfilePhone(userData, expectedPhone) {
      return userData.phoneNumber == expectedPhone
        && userData.branch is string
        && userData.branch.size() >= 2
        && userData.semester is string
        && userData.semester.size() >= 1;
    }

    function hasSavedPhone(uid, expectedPhone) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && matchesUserProfilePhone(get(/databases/$(database)/documents/users/$(uid)).data, expectedPhone);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'branch', 'semester', 'phoneNumber', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'branch', 'semester', 'phoneNumber', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 80
        && data.branch is string
        && data.branch.size() >= 2
        && data.branch.size() <= 60
        && data.semester is string
        && data.semester.size() >= 1
        && data.semester.size() <= 20
        && data.phoneNumber is string
        && data.phoneNumber.size() >= 7
        && data.phoneNumber.size() <= 25
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'branch', 'semester', 'visibility', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'branch', 'semester', 'visibility', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 80
        && data.branch is string
        && data.branch.size() >= 2
        && data.branch.size() <= 60
        && data.semester is string
        && data.semester.size() >= 1
        && data.semester.size() <= 20
        && data.visibility is string
        && data.visibility.size() == 6
        && data.visibility == 'campus'
        && data.updatedAt is timestamp;
    }

    function isValidCampusItem(data) {
      return data.keys().hasAll([
          'title',
          'description',
          'photoUrl',
          'category',
          'listingType',
          'price',
          'status',
          'soldToId',
          'soldToName',
          'paymentId',
          'visibility',
          'authorId',
          'authorName',
          'authorPhone',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'description',
          'photoUrl',
          'category',
          'listingType',
          'price',
          'status',
          'soldToId',
          'soldToName',
          'paymentId',
          'visibility',
          'authorId',
          'authorName',
          'authorPhone',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 400
        && data.photoUrl is string
        && data.photoUrl.size() >= 20
        && data.photoUrl.size() <= 250000
        && data.category is string
        && data.category.size() >= 3
        && data.category.size() <= 40
        && data.category in [
          'Shared Item',
          'Permanent Sale',
          'Chargers & Cables',
          'Calculators & Lab',
          'Lab Equipment',
          'Weather Gear',
          'Tech Accessories'
        ]
        && data.listingType is string
        && data.listingType.size() == 4
        && data.listingType in ['lend', 'sell']
        && (data.price is int || data.price is float)
        && (
          (data.listingType == 'lend' && data.price == 0)
          || (data.listingType == 'sell' && data.price >= 1 && data.price <= 100000)
        )
        && data.status is string
        && data.status.size() >= 3
        && data.status.size() <= 20
        && data.status in ['Available', 'Sold']
        && (
          (data.status == 'Available' && data.soldToId == null && data.soldToName == null && data.paymentId == null)
          || (
            data.status == 'Sold'
            && data.listingType == 'sell'
            && data.soldToId is string
            && isValidId(data.soldToId)
            && data.soldToName is string
            && data.soldToName.size() >= 1
            && data.soldToName.size() <= 80
            && data.paymentId is string
            && isValidId(data.paymentId)
          )
        )
        && data.visibility is string
        && data.visibility.size() == 6
        && data.visibility == 'campus'
        && data.authorId is string
        && isValidId(data.authorId)
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 80
        && data.authorPhone is string
        && data.authorPhone.size() >= 7
        && data.authorPhone.size() <= 25
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isImmutableCampusItemCoreUnchanged() {
      return incoming().title == existing().title
        && incoming().description == existing().description
        && incoming().photoUrl == existing().photoUrl
        && incoming().category == existing().category
        && incoming().listingType == existing().listingType
        && incoming().price == existing().price
        && incoming().visibility == existing().visibility
        && incoming().authorId == existing().authorId
        && incoming().authorName == existing().authorName
        && incoming().authorPhone == existing().authorPhone
        && incoming().createdAt == existing().createdAt;
    }

    function isSuccessfulPaymentForItem(paymentData, itemId) {
      return paymentData.status == 'Successful'
        && paymentData.itemId == itemId
        && paymentData.buyerId == request.auth.uid;
    }

    function isPurchaseSellItemAction(itemId) {
      return existing().listingType == 'sell'
        && existing().status == 'Available'
        && incoming().status == 'Sold'
        && request.auth.uid != existing().authorId
        && incoming().soldToId == request.auth.uid
        && isImmutableCampusItemCoreUnchanged()
        && incoming().updatedAt == request.time
        && isValidId(incoming().paymentId)
        && existsAfter(/databases/$(database)/documents/payments/$(incoming().paymentId))
        && isSuccessfulPaymentForItem(
          getAfter(/databases/$(database)/documents/payments/$(incoming().paymentId)).data,
          itemId
        )
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'soldToId',
          'soldToName',
          'paymentId',
          'updatedAt'
        ]);
    }

    function isCompletedPurchaseRequestForItem(reqData, itemId) {
      return reqData.status == 'Completed'
        && reqData.borrowerConfirmed == true
        && reqData.lenderConfirmed == true
        && reqData.itemId == itemId
        && reqData.lenderId == existing().authorId
        && reqData.borrowerId == incoming().soldToId
        && reqData.borrowerName == incoming().soldToName
        && (request.auth.uid == reqData.borrowerId || request.auth.uid == reqData.lenderId);
    }

    function isCompletePurchaseRequestItemAction(itemId) {
      return existing().listingType == 'sell'
        && existing().status == 'Available'
        && incoming().status == 'Sold'
        && isImmutableCampusItemCoreUnchanged()
        && incoming().updatedAt == request.time
        && isValidId(incoming().paymentId)
        && existsAfter(/databases/$(database)/documents/purchaseRequests/$(incoming().paymentId))
        && isCompletedPurchaseRequestForItem(
          getAfter(/databases/$(database)/documents/purchaseRequests/$(incoming().paymentId)).data,
          itemId
        )
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'soldToId',
          'soldToName',
          'paymentId',
          'updatedAt'
        ]);
    }

    function isValidCampusPayment(data) {
      return data.keys().hasAll([
          'transactionRef',
          'itemId',
          'itemTitle',
          'listingType',
          'amount',
          'currency',
          'paymentMethod',
          'payerAccountRef',
          'status',
          'verifiedByBackend',
          'verificationCode',
          'failureReason',
          'buyerId',
          'buyerName',
          'sellerId',
          'sellerName',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'transactionRef',
          'itemId',
          'itemTitle',
          'listingType',
          'amount',
          'currency',
          'paymentMethod',
          'payerAccountRef',
          'status',
          'verifiedByBackend',
          'verificationCode',
          'failureReason',
          'buyerId',
          'buyerName',
          'sellerId',
          'sellerName',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.transactionRef is string
        && data.transactionRef.size() >= 6
        && data.transactionRef.size() <= 40
        && data.itemId is string
        && isValidId(data.itemId)
        && data.itemTitle is string
        && data.itemTitle.size() >= 2
        && data.itemTitle.size() <= 100
        && data.listingType is string
        && data.listingType.size() == 4
        && data.listingType == 'sell'
        && (data.amount is int || data.amount is float)
        && data.amount >= 1
        && data.amount <= 100000
        && data.currency is string
        && data.currency.size() == 3
        && data.currency == 'INR'
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 3
        && data.paymentMethod.size() <= 40
        && data.paymentMethod in ['Campus UPI', 'Campus Direct Pay']
        && data.payerAccountRef is string
        && data.payerAccountRef.size() >= 2
        && data.payerAccountRef.size() <= 80
        && data.status is string
        && data.status.size() >= 6
        && data.status.size() <= 20
        && data.status in ['Pending', 'Successful', 'Failed']
        && data.verifiedByBackend is bool
        && data.verificationCode is string
        && data.verificationCode.size() >= 16
        && data.verificationCode.size() <= 128
        && (data.failureReason == null || (data.failureReason is string && data.failureReason.size() >= 1 && data.failureReason.size() <= 200))
        && data.buyerId is string
        && isValidId(data.buyerId)
        && data.buyerId == request.auth.uid
        && data.buyerName is string
        && data.buyerName.size() >= 1
        && data.buyerName.size() <= 80
        && data.sellerId is string
        && isValidId(data.sellerId)
        && data.sellerId != data.buyerId
        && data.sellerName is string
        && data.sellerName.size() >= 1
        && data.sellerName.size() <= 80
        && data.visibility is string
        && data.visibility.size() == 7
        && data.visibility == 'private'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function matchesSellItemForPayment(itemData, data) {
      return itemData.listingType == 'sell'
        && itemData.status == 'Available'
        && itemData.authorId == data.sellerId
        && itemData.price == data.amount;
    }

    function isValidSellItemForPayment(data) {
      return exists(/databases/$(database)/documents/campusItems/$(data.itemId))
        && matchesSellItemForPayment(
          get(/databases/$(database)/documents/campusItems/$(data.itemId)).data,
          data
        );
    }

    function isImmutablePaymentCoreUnchanged() {
      return incoming().transactionRef == existing().transactionRef
        && incoming().itemId == existing().itemId
        && incoming().itemTitle == existing().itemTitle
        && incoming().listingType == existing().listingType
        && incoming().amount == existing().amount
        && incoming().currency == existing().currency
        && incoming().paymentMethod == existing().paymentMethod
        && incoming().payerAccountRef == existing().payerAccountRef
        && incoming().buyerId == existing().buyerId
        && incoming().buyerName == existing().buyerName
        && incoming().sellerId == existing().sellerId
        && incoming().sellerName == existing().sellerName
        && incoming().visibility == existing().visibility
        && incoming().createdAt == existing().createdAt;
    }

    function isValidPurchaseRequest(data) {
      return data.keys().hasAll([
          'itemId',
          'itemTitle',
          'itemPhotoUrl',
          'listedPrice',
          'finalAmount',
          'borrowerId',
          'borrowerName',
          'borrowerPhone',
          'borrowerRatingAverage',
          'borrowerRatingCount',
          'lenderId',
          'lenderName',
          'lenderPhone',
          'status',
          'borrowerConfirmed',
          'borrowerConfirmedAt',
          'lenderConfirmed',
          'lenderConfirmedAt',
          'completedAt',
          'cancelledAt',
          'cancelledById',
          'cancelledByRole',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'itemId',
          'itemTitle',
          'itemPhotoUrl',
          'listedPrice',
          'finalAmount',
          'borrowerId',
          'borrowerName',
          'borrowerPhone',
          'borrowerRatingAverage',
          'borrowerRatingCount',
          'lenderId',
          'lenderName',
          'lenderPhone',
          'status',
          'borrowerConfirmed',
          'borrowerConfirmedAt',
          'lenderConfirmed',
          'lenderConfirmedAt',
          'completedAt',
          'cancelledAt',
          'cancelledById',
          'cancelledByRole',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.itemId is string
        && isValidId(data.itemId)
        && data.itemTitle is string
        && data.itemTitle.size() >= 2
        && data.itemTitle.size() <= 100
        && (data.itemPhotoUrl == null || (data.itemPhotoUrl is string && data.itemPhotoUrl.size() >= 1 && data.itemPhotoUrl.size() <= 250000))
        && (data.listedPrice is int || data.listedPrice is float)
        && data.listedPrice >= 1
        && data.listedPrice <= 100000
        && (data.finalAmount is int || data.finalAmount is float)
        && data.finalAmount >= 1
        && data.finalAmount <= 100000
        && data.borrowerId is string
        && isValidId(data.borrowerId)
        && data.borrowerName is string
        && data.borrowerName.size() >= 1
        && data.borrowerName.size() <= 80
        && data.borrowerPhone is string
        && data.borrowerPhone.size() >= 7
        && data.borrowerPhone.size() <= 25
        && (data.borrowerRatingAverage is int || data.borrowerRatingAverage is float)
        && data.borrowerRatingAverage >= 0
        && data.borrowerRatingAverage <= 5
        && data.borrowerRatingCount is int
        && data.borrowerRatingCount >= 0
        && data.borrowerRatingCount <= 100000
        && data.lenderId is string
        && isValidId(data.lenderId)
        && data.lenderId != data.borrowerId
        && data.lenderName is string
        && data.lenderName.size() >= 1
        && data.lenderName.size() <= 80
        && data.lenderPhone is string
        && data.lenderPhone.size() >= 7
        && data.lenderPhone.size() <= 25
        && data.status is string
        && data.status.size() >= 7
        && data.status.size() <= 20
        && data.status in ['Pending', 'Completed', 'Cancelled']
        && data.borrowerConfirmed is bool
        && ((data.borrowerConfirmed == false && data.borrowerConfirmedAt == null) || (data.borrowerConfirmed == true && data.borrowerConfirmedAt is timestamp))
        && data.lenderConfirmed is bool
        && ((data.lenderConfirmed == false && data.lenderConfirmedAt == null) || (data.lenderConfirmed == true && data.lenderConfirmedAt is timestamp))
        && (
          (
            data.status == 'Pending'
            && !(data.borrowerConfirmed && data.lenderConfirmed)
            && data.completedAt == null
            && data.cancelledAt == null
            && data.cancelledById == null
            && data.cancelledByRole == null
          )
          || (
            data.status == 'Completed'
            && data.borrowerConfirmed == true
            && data.lenderConfirmed == true
            && data.completedAt is timestamp
            && data.cancelledAt == null
            && data.cancelledById == null
            && data.cancelledByRole == null
          )
          || (
            data.status == 'Cancelled'
            && !(data.borrowerConfirmed && data.lenderConfirmed)
            && data.completedAt == null
            && data.cancelledAt is timestamp
            && data.cancelledById is string
            && isValidId(data.cancelledById)
            && data.cancelledByRole is string
            && data.cancelledByRole.size() >= 6
            && data.cancelledByRole.size() <= 8
            && data.cancelledByRole in ['borrower', 'lender']
          )
        )
        && data.visibility is string
        && data.visibility.size() == 7
        && data.visibility == 'private'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function matchesSellItemForPurchaseRequest(itemData, data) {
      return itemData.listingType == 'sell'
        && itemData.status == 'Available'
        && itemData.authorId == data.lenderId
        && itemData.authorPhone == data.lenderPhone
        && itemData.price == data.listedPrice;
    }

    function isValidSellItemForPurchaseRequest(data) {
      return exists(/databases/$(database)/documents/campusItems/$(data.itemId))
        && matchesSellItemForPurchaseRequest(
          get(/databases/$(database)/documents/campusItems/$(data.itemId)).data,
          data
        );
    }

    function isImmutablePurchaseRequestCoreUnchanged() {
      return incoming().itemId == existing().itemId
        && incoming().itemTitle == existing().itemTitle
        && incoming().itemPhotoUrl == existing().itemPhotoUrl
        && incoming().listedPrice == existing().listedPrice
        && incoming().borrowerId == existing().borrowerId
        && incoming().borrowerName == existing().borrowerName
        && incoming().borrowerPhone == existing().borrowerPhone
        && incoming().borrowerRatingAverage == existing().borrowerRatingAverage
        && incoming().borrowerRatingCount == existing().borrowerRatingCount
        && incoming().lenderId == existing().lenderId
        && incoming().lenderName == existing().lenderName
        && incoming().lenderPhone == existing().lenderPhone
        && incoming().visibility == existing().visibility
        && incoming().createdAt == existing().createdAt;
    }

    function isBorrowerConfirmPurchaseAction() {
      return request.auth.uid == existing().borrowerId
        && existing().borrowerConfirmed == false
        && incoming().borrowerConfirmed == true
        && incoming().borrowerConfirmedAt == request.time
        && incoming().lenderConfirmed == existing().lenderConfirmed
        && incoming().lenderConfirmedAt == existing().lenderConfirmedAt
        && incoming().cancelledAt == null
        && incoming().cancelledById == null
        && incoming().cancelledByRole == null
        && (
          (
            existing().lenderConfirmed == false
            && incoming().status == 'Pending'
            && incoming().completedAt == null
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'borrowerConfirmed',
              'borrowerConfirmedAt',
              'finalAmount',
              'updatedAt'
            ])
          )
          || (
            existing().lenderConfirmed == true
            && incoming().status == 'Completed'
            && incoming().completedAt == request.time
            && incoming().finalAmount == existing().finalAmount
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'borrowerConfirmed',
              'borrowerConfirmedAt',
              'status',
              'completedAt',
              'updatedAt'
            ])
          )
        );
    }

    function isLenderConfirmPurchaseAction() {
      return request.auth.uid == existing().lenderId
        && existing().lenderConfirmed == false
        && incoming().lenderConfirmed == true
        && incoming().lenderConfirmedAt == request.time
        && incoming().borrowerConfirmed == existing().borrowerConfirmed
        && incoming().borrowerConfirmedAt == existing().borrowerConfirmedAt
        && incoming().cancelledAt == null
        && incoming().cancelledById == null
        && incoming().cancelledByRole == null
        && (
          (
            existing().borrowerConfirmed == false
            && incoming().status == 'Pending'
            && incoming().completedAt == null
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lenderConfirmed',
              'lenderConfirmedAt',
              'finalAmount',
              'updatedAt'
            ])
          )
          || (
            existing().borrowerConfirmed == true
            && incoming().status == 'Completed'
            && incoming().completedAt == request.time
            && incoming().finalAmount == existing().finalAmount
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lenderConfirmed',
              'lenderConfirmedAt',
              'status',
              'completedAt',
              'updatedAt'
            ])
          )
        );
    }

    function isCancelPurchaseRequestAction() {
      return (
          (request.auth.uid == existing().borrowerId && incoming().cancelledByRole == 'borrower')
          || (request.auth.uid == existing().lenderId && incoming().cancelledByRole == 'lender')
        )
        && incoming().status == 'Cancelled'
        && incoming().cancelledAt == request.time
        && incoming().cancelledById == request.auth.uid
        && incoming().completedAt == null
        && incoming().borrowerConfirmed == existing().borrowerConfirmed
        && incoming().borrowerConfirmedAt == existing().borrowerConfirmedAt
        && incoming().lenderConfirmed == existing().lenderConfirmed
        && incoming().lenderConfirmedAt == existing().lenderConfirmedAt
        && incoming().finalAmount == existing().finalAmount
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'cancelledAt',
          'cancelledById',
          'cancelledByRole',
          'updatedAt'
        ]);
    }

    function isValidRequestLock(data) {
      return data.keys().hasAll(['requestId', 'itemId', 'borrowerId', 'lenderId', 'createdAt'])
        && data.keys().hasOnly(['requestId', 'itemId', 'borrowerId', 'lenderId', 'createdAt'])
        && data.requestId is string
        && isValidId(data.requestId)
        && data.itemId is string
        && isValidId(data.itemId)
        && data.borrowerId is string
        && isValidId(data.borrowerId)
        && data.borrowerId == request.auth.uid
        && data.lenderId is string
        && isValidId(data.lenderId)
        && data.lenderId != data.borrowerId
        && data.createdAt is timestamp;
    }

    function matchesCreatedPurchaseLockTarget(reqData, lockData) {
      return reqData.itemId == lockData.itemId
        && reqData.borrowerId == request.auth.uid
        && reqData.lenderId == lockData.lenderId;
    }

    function matchesCreatedBorrowLockTarget(reqData, lockData) {
      return reqData.itemId == lockData.itemId
        && reqData.requesterId == request.auth.uid
        && reqData.acceptedById == lockData.lenderId;
    }

    function isValidPrivateBorrowRequest(data) {
      return data.keys().hasAll([
          'description',
          'itemId',
          'itemTitle',
          'itemPhotoUrl',
          'status',
          'visibility',
          'requesterId',
          'requesterName',
          'requesterPhone',
          'borrowerRatingAverage',
          'borrowerRatingCount',
          'acceptedById',
          'acceptedByName',
          'acceptedByPhone',
          'borrowerFulfilled',
          'borrowerFulfilledAt',
          'lenderFulfilled',
          'lenderFulfilledAt',
          'completedAt',
          'cancelledAt',
          'cancelledById',
          'cancelledByRole',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'description',
          'itemId',
          'itemTitle',
          'itemPhotoUrl',
          'status',
          'visibility',
          'requesterId',
          'requesterName',
          'requesterPhone',
          'borrowerRatingAverage',
          'borrowerRatingCount',
          'acceptedById',
          'acceptedByName',
          'acceptedByPhone',
          'borrowerFulfilled',
          'borrowerFulfilledAt',
          'lenderFulfilled',
          'lenderFulfilledAt',
          'completedAt',
          'cancelledAt',
          'cancelledById',
          'cancelledByRole',
          'createdAt',
          'updatedAt'
        ])
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 400
        && data.itemId is string
        && isValidId(data.itemId)
        && data.itemTitle is string
        && data.itemTitle.size() >= 2
        && data.itemTitle.size() <= 100
        && (data.itemPhotoUrl == null || (data.itemPhotoUrl is string && data.itemPhotoUrl.size() >= 1 && data.itemPhotoUrl.size() <= 250000))
        && data.status is string
        && data.status.size() >= 7
        && data.status.size() <= 20
        && data.status in ['Pending', 'Fulfilled', 'Cancelled']
        && data.visibility is string
        && data.visibility.size() == 7
        && data.visibility == 'private'
        && data.requesterId is string
        && isValidId(data.requesterId)
        && data.requesterName is string
        && data.requesterName.size() >= 1
        && data.requesterName.size() <= 80
        && data.requesterPhone is string
        && data.requesterPhone.size() >= 7
        && data.requesterPhone.size() <= 25
        && (data.borrowerRatingAverage is int || data.borrowerRatingAverage is float)
        && data.borrowerRatingAverage >= 0
        && data.borrowerRatingAverage <= 5
        && data.borrowerRatingCount is int
        && data.borrowerRatingCount >= 0
        && data.borrowerRatingCount <= 100000
        && data.acceptedById is string
        && isValidId(data.acceptedById)
        && data.acceptedById != data.requesterId
        && data.acceptedByName is string
        && data.acceptedByName.size() >= 1
        && data.acceptedByName.size() <= 80
        && data.acceptedByPhone is string
        && data.acceptedByPhone.size() >= 7
        && data.acceptedByPhone.size() <= 25
        && data.borrowerFulfilled is bool
        && ((data.borrowerFulfilled == false && data.borrowerFulfilledAt == null) || (data.borrowerFulfilled == true && data.borrowerFulfilledAt is timestamp))
        && data.lenderFulfilled is bool
        && ((data.lenderFulfilled == false && data.lenderFulfilledAt == null) || (data.lenderFulfilled == true && data.lenderFulfilledAt is timestamp))
        && (
          (
            data.status == 'Pending'
            && !(data.borrowerFulfilled && data.lenderFulfilled)
            && data.completedAt == null
            && data.cancelledAt == null
            && data.cancelledById == null
            && data.cancelledByRole == null
          )
          || (
            data.status == 'Fulfilled'
            && data.borrowerFulfilled == true
            && data.lenderFulfilled == true
            && data.completedAt is timestamp
            && data.cancelledAt == null
            && data.cancelledById == null
            && data.cancelledByRole == null
          )
          || (
            data.status == 'Cancelled'
            && !(data.borrowerFulfilled && data.lenderFulfilled)
            && data.completedAt == null
            && data.cancelledAt is timestamp
            && data.cancelledById is string
            && isValidId(data.cancelledById)
            && data.cancelledByRole is string
            && data.cancelledByRole.size() >= 6
            && data.cancelledByRole.size() <= 8
            && data.cancelledByRole in ['borrower', 'lender']
          )
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLegacyCampusRequest(data) {
      return data.keys().hasAll([
          'description',
          'itemId',
          'itemTitle',
          'itemPhotoUrl',
          'status',
          'visibility',
          'requesterId',
          'requesterName',
          'requesterPhone',
          'acceptedById',
          'acceptedByName',
          'acceptedByPhone',
          'borrowerFulfilled',
          'lenderFulfilled',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'description',
          'itemId',
          'itemTitle',
          'itemPhotoUrl',
          'status',
          'visibility',
          'requesterId',
          'requesterName',
          'requesterPhone',
          'acceptedById',
          'acceptedByName',
          'acceptedByPhone',
          'borrowerFulfilled',
          'lenderFulfilled',
          'createdAt',
          'updatedAt'
        ])
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 400
        && (data.itemId == null || (data.itemId is string && isValidId(data.itemId)))
        && (data.itemTitle == null || (data.itemTitle is string && data.itemTitle.size() >= 2 && data.itemTitle.size() <= 100))
        && (data.itemPhotoUrl == null || (data.itemPhotoUrl is string && data.itemPhotoUrl.size() >= 1 && data.itemPhotoUrl.size() <= 250000))
        && data.status is string
        && data.status.size() >= 4
        && data.status.size() <= 20
        && data.status in ['Accepted', 'Fulfilled', 'Cancelled']
        && data.visibility is string
        && data.visibility.size() >= 6
        && data.visibility.size() <= 7
        && data.visibility in ['campus', 'private']
        && data.requesterId is string
        && isValidId(data.requesterId)
        && data.requesterName is string
        && data.requesterName.size() >= 1
        && data.requesterName.size() <= 80
        && data.requesterPhone is string
        && data.requesterPhone.size() >= 7
        && data.requesterPhone.size() <= 25
        && data.acceptedById is string
        && isValidId(data.acceptedById)
        && data.acceptedByName is string
        && data.acceptedByName.size() >= 1
        && data.acceptedByName.size() <= 80
        && data.acceptedByPhone is string
        && data.acceptedByPhone.size() >= 7
        && data.acceptedByPhone.size() <= 25
        && data.borrowerFulfilled is bool
        && data.lenderFulfilled is bool
        && (
          (data.status == 'Accepted' && !(data.borrowerFulfilled && data.lenderFulfilled))
          || (data.status == 'Fulfilled' && data.borrowerFulfilled == true && data.lenderFulfilled == true)
          || (data.status == 'Cancelled' && !(data.borrowerFulfilled && data.lenderFulfilled))
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function matchesLendItemForBorrowRequest(itemData, data) {
      return itemData.listingType == 'lend'
        && itemData.status == 'Available'
        && itemData.authorId == data.acceptedById
        && itemData.authorPhone == data.acceptedByPhone;
    }

    function isValidLendItemForBorrowRequest(data) {
      return exists(/databases/$(database)/documents/campusItems/$(data.itemId))
        && matchesLendItemForBorrowRequest(
          get(/databases/$(database)/documents/campusItems/$(data.itemId)).data,
          data
        );
    }

    function isImmutablePrivateBorrowCoreUnchanged() {
      return incoming().createdAt == existing().createdAt
        && incoming().requesterId == existing().requesterId
        && incoming().requesterName == existing().requesterName
        && incoming().requesterPhone == existing().requesterPhone
        && incoming().borrowerRatingAverage == existing().borrowerRatingAverage
        && incoming().borrowerRatingCount == existing().borrowerRatingCount
        && incoming().acceptedById == existing().acceptedById
        && incoming().acceptedByName == existing().acceptedByName
        && incoming().acceptedByPhone == existing().acceptedByPhone
        && incoming().description == existing().description
        && incoming().visibility == existing().visibility
        && incoming().itemId == existing().itemId
        && incoming().itemTitle == existing().itemTitle
        && incoming().itemPhotoUrl == existing().itemPhotoUrl;
    }

    function isImmutableLegacyRequestCoreUnchanged() {
      return incoming().createdAt == existing().createdAt
        && incoming().requesterId == existing().requesterId
        && incoming().requesterName == existing().requesterName
        && incoming().requesterPhone == existing().requesterPhone
        && incoming().acceptedById == existing().acceptedById
        && incoming().acceptedByName == existing().acceptedByName
        && incoming().acceptedByPhone == existing().acceptedByPhone
        && incoming().description == existing().description
        && incoming().visibility == existing().visibility
        && incoming().itemId == existing().itemId
        && incoming().itemTitle == existing().itemTitle
        && incoming().itemPhotoUrl == existing().itemPhotoUrl;
    }

    function isBorrowerConfirmPrivateBorrowAction() {
      return existing().status == 'Pending'
        && request.auth.uid == existing().requesterId
        && existing().borrowerFulfilled == false
        && incoming().borrowerFulfilled == true
        && incoming().borrowerFulfilledAt == request.time
        && incoming().lenderFulfilled == existing().lenderFulfilled
        && incoming().lenderFulfilledAt == existing().lenderFulfilledAt
        && incoming().cancelledAt == null
        && incoming().cancelledById == null
        && incoming().cancelledByRole == null
        && (
          (
            existing().lenderFulfilled == false
            && incoming().status == 'Pending'
            && incoming().completedAt == null
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'borrowerFulfilled',
              'borrowerFulfilledAt',
              'updatedAt'
            ])
          )
          || (
            existing().lenderFulfilled == true
            && incoming().status == 'Fulfilled'
            && incoming().completedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'borrowerFulfilled',
              'borrowerFulfilledAt',
              'status',
              'completedAt',
              'updatedAt'
            ])
          )
        );
    }

    function isLenderConfirmPrivateBorrowAction() {
      return existing().status == 'Pending'
        && request.auth.uid == existing().acceptedById
        && existing().lenderFulfilled == false
        && incoming().lenderFulfilled == true
        && incoming().lenderFulfilledAt == request.time
        && incoming().borrowerFulfilled == existing().borrowerFulfilled
        && incoming().borrowerFulfilledAt == existing().borrowerFulfilledAt
        && incoming().cancelledAt == null
        && incoming().cancelledById == null
        && incoming().cancelledByRole == null
        && (
          (
            existing().borrowerFulfilled == false
            && incoming().status == 'Pending'
            && incoming().completedAt == null
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lenderFulfilled',
              'lenderFulfilledAt',
              'updatedAt'
            ])
          )
          || (
            existing().borrowerFulfilled == true
            && incoming().status == 'Fulfilled'
            && incoming().completedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lenderFulfilled',
              'lenderFulfilledAt',
              'status',
              'completedAt',
              'updatedAt'
            ])
          )
        );
    }

    function isCancelPrivateBorrowAction() {
      return existing().status == 'Pending'
        && (
          (request.auth.uid == existing().requesterId && incoming().cancelledByRole == 'borrower')
          || (request.auth.uid == existing().acceptedById && incoming().cancelledByRole == 'lender')
        )
        && incoming().status == 'Cancelled'
        && incoming().cancelledAt == request.time
        && incoming().cancelledById == request.auth.uid
        && incoming().completedAt == null
        && incoming().borrowerFulfilled == existing().borrowerFulfilled
        && incoming().borrowerFulfilledAt == existing().borrowerFulfilledAt
        && incoming().lenderFulfilled == existing().lenderFulfilled
        && incoming().lenderFulfilledAt == existing().lenderFulfilledAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'cancelledAt',
          'cancelledById',
          'cancelledByRole',
          'updatedAt'
        ]);
    }

    function isLegacyBorrowFulfillOrCancelAction() {
      return existing().status == 'Accepted'
        && (
          (
            request.auth.uid == existing().requesterId
            && existing().borrowerFulfilled == false
            && incoming().borrowerFulfilled == true
            && incoming().lenderFulfilled == existing().lenderFulfilled
            && (
              (existing().lenderFulfilled == true && incoming().status == 'Fulfilled')
              || (existing().lenderFulfilled == false && incoming().status == 'Accepted')
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'borrowerFulfilled',
              'status',
              'updatedAt'
            ])
          )
          || (
            request.auth.uid == existing().acceptedById
            && existing().lenderFulfilled == false
            && incoming().lenderFulfilled == true
            && incoming().borrowerFulfilled == existing().borrowerFulfilled
            && (
              (existing().borrowerFulfilled == true && incoming().status == 'Fulfilled')
              || (existing().borrowerFulfilled == false && incoming().status == 'Accepted')
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lenderFulfilled',
              'status',
              'updatedAt'
            ])
          )
          || (
            (request.auth.uid == existing().requesterId || request.auth.uid == existing().acceptedById)
            && incoming().status == 'Cancelled'
            && incoming().borrowerFulfilled == existing().borrowerFulfilled
            && incoming().lenderFulfilled == existing().lenderFulfilled
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'updatedAt'
            ])
          )
        );
    }

    function isValidExchangeRating(data) {
      return data.keys().hasAll([
          'requestId',
          'exchangeSummary',
          'raterId',
          'raterName',
          'raterRole',
          'rateeId',
          'rateeName',
          'score',
          'comment',
          'isEdited',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'requestId',
          'exchangeSummary',
          'raterId',
          'raterName',
          'raterRole',
          'rateeId',
          'rateeName',
          'score',
          'comment',
          'isEdited',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && data.requestId is string
        && isValidId(data.requestId)
        && data.exchangeSummary is string
        && data.exchangeSummary.size() >= 1
        && data.exchangeSummary.size() <= 120
        && data.raterId is string
        && isValidId(data.raterId)
        && data.raterId == request.auth.uid
        && data.raterName is string
        && data.raterName.size() >= 1
        && data.raterName.size() <= 80
        && data.raterRole is string
        && data.raterRole.size() >= 6
        && data.raterRole.size() <= 8
        && data.raterRole in ['borrower', 'lender']
        && data.rateeId is string
        && isValidId(data.rateeId)
        && data.rateeId != data.raterId
        && data.rateeName is string
        && data.rateeName.size() >= 1
        && data.rateeName.size() <= 80
        && data.score is int
        && data.score >= 1
        && data.score <= 5
        && data.comment is string
        && data.comment.size() >= 0
        && data.comment.size() <= 300
        && data.isEdited is bool
        && data.visibility is string
        && data.visibility.size() == 6
        && data.visibility == 'campus'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function matchesFulfilledBorrowParticipant(reqData, ratingData) {
      return reqData.status == 'Fulfilled'
        && (
          (
            ratingData.raterRole == 'borrower'
            && ratingData.raterId == reqData.requesterId
            && ratingData.rateeId == reqData.acceptedById
          )
          || (
            ratingData.raterRole == 'lender'
            && ratingData.raterId == reqData.acceptedById
            && ratingData.rateeId == reqData.requesterId
          )
        );
    }

    function matchesCompletedPurchaseParticipant(reqData, ratingData) {
      return reqData.status == 'Completed'
        && (
          (
            ratingData.raterRole == 'borrower'
            && ratingData.raterId == reqData.borrowerId
            && ratingData.rateeId == reqData.lenderId
          )
          || (
            ratingData.raterRole == 'lender'
            && ratingData.raterId == reqData.lenderId
            && ratingData.rateeId == reqData.borrowerId
          )
        );
    }

    function isValidFulfilledExchangeParticipant(data) {
      return (
          exists(/databases/$(database)/documents/campusRequests/$(data.requestId))
          && matchesFulfilledBorrowParticipant(
            get(/databases/$(database)/documents/campusRequests/$(data.requestId)).data,
            data
          )
        )
        || (
          exists(/databases/$(database)/documents/purchaseRequests/$(data.requestId))
          && matchesCompletedPurchaseParticipant(
            get(/databases/$(database)/documents/purchaseRequests/$(data.requestId)).data,
            data
          )
        );
    }

    function isEditRatingAction() {
      return existing().raterId == request.auth.uid
        && request.time < existing().createdAt + duration.value(24, 'h')
        && incoming().requestId == existing().requestId
        && incoming().exchangeSummary == existing().exchangeSummary
        && incoming().raterId == existing().raterId
        && incoming().raterName == existing().raterName
        && incoming().raterRole == existing().raterRole
        && incoming().rateeId == existing().rateeId
        && incoming().rateeName == existing().rateeName
        && incoming().visibility == existing().visibility
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().isEdited == true
        && incoming().diff(existing()).affectedKeys().hasOnly(['score', 'comment', 'isEdited', 'updatedAt']);
    }

    match /users/{userId} {
      allow get: if isCampusEmail() && isValidId(userId) && userId == request.auth.uid;
      allow list: if false;
      allow create: if isCampusEmail()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isCampusEmail()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'branch', 'semester', 'phoneNumber', 'updatedAt']);
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow get: if isCampusEmail()
        && isValidId(userId)
        && (userId == request.auth.uid || (resource != null && existing().visibility == 'campus'));
      allow list: if isCampusEmail() && existing().visibility == 'campus';
      allow create: if isCampusEmail()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidPublicProfile(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isCampusEmail()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidPublicProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().visibility == existing().visibility
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'branch', 'semester', 'updatedAt']);
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow get: if isCampusEmail()
        && isValidId(adminId)
        && (adminId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(adminId)
        && isValidAdminUser(incoming(), adminId);
      allow update: if false;
      allow delete: if isAdmin()
        && isValidId(adminId)
        && resource != null;
    }

    match /campusItems/{itemId} {
      allow get: if isCampusEmail() && isValidId(itemId) && (resource == null || existing().visibility == 'campus');
      allow list: if isCampusEmail() && existing().visibility == 'campus';
      allow create: if isCampusEmail()
        && isValidId(itemId)
        && isValidCampusItem(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().status == 'Available'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasSavedPhone(request.auth.uid, incoming().authorPhone);
      allow update: if isCampusEmail()
        && isValidId(itemId)
        && isValidCampusItem(incoming())
        && (isCompletePurchaseRequestItemAction(itemId) || isPurchaseSellItemAction(itemId));
      allow delete: if isCampusEmail()
        && isValidId(itemId)
        && resource != null
        && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /payments/{paymentId} {
      allow get: if isCampusEmail()
        && isValidId(paymentId)
        && (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid || isAdmin());
      allow list: if isCampusEmail()
        && (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid || isAdmin());
      allow create: if isCampusEmail()
        && isValidId(paymentId)
        && isValidCampusPayment(incoming())
        && incoming().status == 'Pending'
        && incoming().verifiedByBackend == false
        && incoming().failureReason == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isValidSellItemForPayment(incoming());
      allow update: if isCampusEmail()
        && isValidId(paymentId)
        && isValidCampusPayment(incoming())
        && existing().buyerId == request.auth.uid
        && existing().status == 'Pending'
        && incoming().status in ['Successful', 'Failed']
        && incoming().verifiedByBackend == true
        && incoming().updatedAt == request.time
        && isImmutablePaymentCoreUnchanged()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'verifiedByBackend',
          'verificationCode',
          'failureReason',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /purchaseRequests/{requestId} {
      allow get: if isCampusEmail()
        && isValidId(requestId)
        && (
          existing().borrowerId == request.auth.uid
          || existing().lenderId == request.auth.uid
          || isAdmin()
        );
      allow list: if isCampusEmail()
        && (
          existing().borrowerId == request.auth.uid
          || existing().lenderId == request.auth.uid
          || isAdmin()
        );
      allow create: if isCampusEmail()
        && isValidId(requestId)
        && isValidPurchaseRequest(incoming())
        && incoming().borrowerId == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().borrowerConfirmed == false
        && incoming().borrowerConfirmedAt == null
        && incoming().lenderConfirmed == false
        && incoming().lenderConfirmedAt == null
        && incoming().completedAt == null
        && incoming().cancelledAt == null
        && incoming().cancelledById == null
        && incoming().cancelledByRole == null
        && incoming().finalAmount == incoming().listedPrice
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasSavedPhone(request.auth.uid, incoming().borrowerPhone)
        && isValidSellItemForPurchaseRequest(incoming())
        && !exists(/databases/$(database)/documents/purchaseRequestLocks/$(incoming().itemId + '_' + request.auth.uid))
        && existsAfter(/databases/$(database)/documents/purchaseRequestLocks/$(incoming().itemId + '_' + request.auth.uid))
        && getAfter(/databases/$(database)/documents/purchaseRequestLocks/$(incoming().itemId + '_' + request.auth.uid)).data.requestId == requestId;
      allow update: if isCampusEmail()
        && isValidId(requestId)
        && isValidPurchaseRequest(incoming())
        && existing().status == 'Pending'
        && incoming().updatedAt == request.time
        && isImmutablePurchaseRequestCoreUnchanged()
        && (
          isBorrowerConfirmPurchaseAction()
          || isLenderConfirmPurchaseAction()
          || isCancelPurchaseRequestAction()
        );
      allow delete: if isCampusEmail()
        && isValidId(requestId)
        && resource != null
        && isAdmin();
    }

    match /purchaseRequestLocks/{lockId} {
      allow get: if isCampusEmail()
        && isValidId(lockId)
        && (
          resource == null
          || existing().borrowerId == request.auth.uid
          || existing().lenderId == request.auth.uid
          || isAdmin()
        );
      allow list: if false;
      allow create: if isCampusEmail()
        && isValidId(lockId)
        && isValidRequestLock(incoming())
        && lockId == incoming().itemId + '_' + request.auth.uid
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/purchaseRequests/$(incoming().requestId))
        && matchesCreatedPurchaseLockTarget(
          getAfter(/databases/$(database)/documents/purchaseRequests/$(incoming().requestId)).data,
          incoming()
        );
      allow update: if false;
      allow delete: if isCampusEmail()
        && isValidId(lockId)
        && resource != null
        && (
          existing().borrowerId == request.auth.uid
          || existing().lenderId == request.auth.uid
          || isAdmin()
        )
        && (
          !existsAfter(/databases/$(database)/documents/purchaseRequests/$(existing().requestId))
          || getAfter(/databases/$(database)/documents/purchaseRequests/$(existing().requestId)).data.status in ['Completed', 'Cancelled']
        );
    }

    match /campusRequests/{requestId} {
      allow get: if isCampusEmail()
        && isValidId(requestId)
        && (
          existing().requesterId == request.auth.uid
          || existing().acceptedById == request.auth.uid
          || isAdmin()
        );
      allow list: if isCampusEmail()
        && (
          existing().requesterId == request.auth.uid
          || existing().acceptedById == request.auth.uid
          || isAdmin()
        );
      allow create: if isCampusEmail()
        && isValidId(requestId)
        && isValidPrivateBorrowRequest(incoming())
        && incoming().requesterId == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().borrowerFulfilled == false
        && incoming().borrowerFulfilledAt == null
        && incoming().lenderFulfilled == false
        && incoming().lenderFulfilledAt == null
        && incoming().completedAt == null
        && incoming().cancelledAt == null
        && incoming().cancelledById == null
        && incoming().cancelledByRole == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasSavedPhone(request.auth.uid, incoming().requesterPhone)
        && isValidLendItemForBorrowRequest(incoming())
        && !exists(/databases/$(database)/documents/borrowRequestLocks/$(incoming().itemId + '_' + request.auth.uid))
        && existsAfter(/databases/$(database)/documents/borrowRequestLocks/$(incoming().itemId + '_' + request.auth.uid))
        && getAfter(/databases/$(database)/documents/borrowRequestLocks/$(incoming().itemId + '_' + request.auth.uid)).data.requestId == requestId;
      allow update: if isCampusEmail()
        && isValidId(requestId)
        && existing().status in ['Pending', 'Accepted']
        && incoming().updatedAt == request.time
        && (
          (
            isValidPrivateBorrowRequest(incoming())
            && isImmutablePrivateBorrowCoreUnchanged()
            && (
              isBorrowerConfirmPrivateBorrowAction()
              || isLenderConfirmPrivateBorrowAction()
              || isCancelPrivateBorrowAction()
            )
          )
          || (
            isValidLegacyCampusRequest(incoming())
            && isImmutableLegacyRequestCoreUnchanged()
            && isLegacyBorrowFulfillOrCancelAction()
          )
        );
      allow delete: if isCampusEmail()
        && isValidId(requestId)
        && resource != null
        && isAdmin();
    }

    match /borrowRequestLocks/{lockId} {
      allow get: if isCampusEmail()
        && isValidId(lockId)
        && (
          resource == null
          || existing().borrowerId == request.auth.uid
          || existing().lenderId == request.auth.uid
          || isAdmin()
        );
      allow list: if false;
      allow create: if isCampusEmail()
        && isValidId(lockId)
        && isValidRequestLock(incoming())
        && lockId == incoming().itemId + '_' + request.auth.uid
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/campusRequests/$(incoming().requestId))
        && matchesCreatedBorrowLockTarget(
          getAfter(/databases/$(database)/documents/campusRequests/$(incoming().requestId)).data,
          incoming()
        );
      allow update: if false;
      allow delete: if isCampusEmail()
        && isValidId(lockId)
        && resource != null
        && (
          existing().borrowerId == request.auth.uid
          || existing().lenderId == request.auth.uid
          || isAdmin()
        )
        && (
          !existsAfter(/databases/$(database)/documents/campusRequests/$(existing().requestId))
          || getAfter(/databases/$(database)/documents/campusRequests/$(existing().requestId)).data.status in ['Fulfilled', 'Cancelled']
        );
    }

    match /exchangeRatings/{ratingId} {
      allow get: if isCampusEmail()
        && isValidId(ratingId)
        && (resource == null || existing().visibility == 'campus');
      allow list: if isCampusEmail() && existing().visibility == 'campus';
      allow create: if isCampusEmail()
        && isValidId(ratingId)
        && isValidExchangeRating(incoming())
        && ratingId == incoming().requestId + '_' + request.auth.uid
        && incoming().isEdited == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isValidFulfilledExchangeParticipant(incoming());
      allow update: if isCampusEmail()
        && isValidId(ratingId)
        && isValidExchangeRating(incoming())
        && isEditRatingAction();
      allow delete: if false;
    }
  }
}
